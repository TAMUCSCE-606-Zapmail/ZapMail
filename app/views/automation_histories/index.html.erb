<% content_for :title, "Automation History" %>

<h1>Automation History</h1>

<table class="automation-logs-table">
  <thead>
    <tr>
      <th>Time</th>
      <th>Strategy</th>
      <th>Email</th>
      <th>API Response</th>
      <th>Error</th>
    </tr>
  </thead>
  <tbody>
    <% @automation_histories.each do |log| %>
      <tr id="<%= dom_id(log) %>">
        <td><%= log.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
        <td><%= link_to log.automation.strategy.name, log.automation.strategy %></td>
        <td><%= log.row_data.fetch("email", nil) %></td>
        <td><%= truncate(log.api_response.to_s, length: 60) %></td>
        <td><%= truncate(log.error_message.to_s, length: 60) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<nav class="pagination">
  <% if @page > 1 %>
    <%= link_to "Prev", automation_histories_path(page: @page - 1) %>
  <% else %>
    <span class="disabled">Prev</span>
  <% end %>

  <span>Page <%= @page %> of <%= @total_pages.zero? ? 1 : @total_pages %></span>

  <% if @page < @total_pages %>
    <%= link_to "Next", automation_histories_path(page: @page + 1) %>
  <% else %>
    <span class="disabled">Next</span>
  <% end %>
</nav>