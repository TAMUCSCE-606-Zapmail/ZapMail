<p style="color: green"><%= notice %></p>

<% content_for :title, "Strategies" %>
<!-- app/views/strategies/index.html.erb -->
<h1 class="strategies-title">Your Strategies</h1>

<div class="accordion" id="strategiesAccordion">
  <% @strategies.each_with_index do |strategy, idx| %>
    <div class="accordion-item">
      <h2 class="accordion-header" id="heading-<%= idx %>">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapse-<%= idx %>"
                aria-expanded="false"
                aria-controls="collapse-<%= idx %>">
          <%= strategy.name %>
        </button>
      </h2>
      <div id="collapse-<%= idx %>" class="accordion-collapse collapse"
           aria-labelledby="heading-<%= idx %>"
           data-bs-parent="#strategiesAccordion">
        <div class="accordion-body">
          <!-- Rules dropdown -->
          <h5>Rules for <%= strategy.name %></h5>
          <table class="table table-striped table-hover">
            <thead class="table-dark">
              <tr>
                <th scope="col">Rule Number</th>
                <th scope="col">Condition</th>
                <th scope="col">Actions</th>
                <th scope="col">Manage</th>
              </tr>
            </thead>
            <tbody>
              <% strategy.rules.each_with_index do |rule, i| %>
                <tr>
                  <td scope="row"><%= i + 1 %></td>
                  <td>
                    <% if rule.conditions.any? %>
                      <ul class="list-unstyled mb-0">
                        <% rule.conditions.each do |condition| %>
                          <li><%= condition.column_name %> <%= condition.operator %> <%= condition.value %></li>
                        <% end %>
                      </ul>
                    <% else %>
                      <span class="text-muted fst-italic">No conditions</span>
                    <% end %>
                  </td>
                  <td>
                    <% if rule.strategy_actions.any? %>
                      <ul class="list-unstyled mb-0">
                        <% rule.strategy_actions.each do |action| %>
                          <li>
                            <span class="badge bg-primary"><%= action.action_type %></span>
                            <small class="text-muted d-block"><%= truncate(action.prompt_template, length: 40) %></small>
                          </li>
                        <% end %>
                      </ul>
                    <% else %>
                      <span class="text-muted fst-italic">No actions</span>
                    <% end %>
                  </td>
                  <td>
                    <%= link_to "Edit", edit_strategy_rule_path(strategy, rule), class: "btn btn-sm btn-outline-primary" %>
                    <%= link_to "Delete", strategy_rule_path(strategy, rule),
                                  data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                                  class: "btn btn-sm btn-outline-danger" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <h5 style="margin-top: 20px;">Scheduled Automations for <%= strategy.name %></h5>
          <table class="table table-striped table-hover">
            <thead class="table-dark">
              <tr>
                <th scope="col">Automation Number</th>
                <th scope="col">Schedule Type</th>
                <th scope="col">Next Run Time</th>
                <th scope="col">End Time</th>
              </tr>
            </thead>
            <tbody>
              <% strategy.automations.each_with_index do |automation, i| %>
                <tr>
                  <td scope="row"><%= i + 1 %></td>
                  <td>
                    <%= automation.schedule_type %>
                  </td>
                  <td>
                    <%= automation.next_run_time %>
                  </td>
                  <td>
                    <% if automation.end_time %>
                      <span> <%= automation.end_time %> </span>
                    <% else %>
                      <span class="text-muted fst-italic">No End Time</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
  <div class="new-strategy-button-container">
    <%= button_to "+ New strategy", new_strategy_path, method: :get,class: "new-strategy-button" %>
  </div>
</div>


<div style="margin-left: 60px; margin-top: 10px;">
  <%= link_to "Back to Home", root_path %>
</div>
