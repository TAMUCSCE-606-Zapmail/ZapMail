<%# app/views/users/new.html.erb %>
<div class="max-w-lg mx-auto bg-white p-8 rounded-lg shadow-md">
  <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Create Your Account</h1>

  <%= render 'shared/form_errors', object: @user %>

  <%= form_with(model: @user, url: users_path, class: "space-y-6") do |form| %>
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :name, class: "mt-1 block w-full px-3 py-2 border rounded-md shadow-sm form-input focus:outline-none", required: true %>
    </div>

    <div>
      <%= form.label :email, class: "block text-sm font-medium text-gray-700" %>
      <%= form.email_field :email, class: "mt-1 block w-full px-3 py-2 border rounded-md shadow-sm form-input focus:outline-none", required: true %>
    </div>

    <div>
      <%= form.label :password, class: "block text-sm font-medium text-gray-700" %>
      <%= form.password_field :password, class: "mt-1 block w-full px-3 py-2 border rounded-md shadow-sm form-input focus:outline-none", required: true %>
    </div>

    <div>
      <%= form.label :password_confirmation, class: "block text-sm font-medium text-gray-700" %>
      <%= form.password_field :password_confirmation, class: "mt-1 block w-full px-3 py-2 border rounded-md shadow-sm form-input focus:outline-none", required: true %>
    </div>

    <div class="text-center">
      <%= form.submit "Create Account", class: "bg-tamu-maroon text-tamu-white border border-tamu-maroon hover:text-tamu-maroon hover:bg-tamu-white w-full cursor-pointer btn-primary font-semibold py-3 px-4 rounded-lg hover:bg-opacity-90 transition duration-200" %>
    </div>
  <% end %>

  <p class="text-center mt-6 text-sm text-gray-600">
    Already have an account? <%= link_to 'Log In', login_path, class: 'link-primary font-medium' %>
  </p>
</div>
