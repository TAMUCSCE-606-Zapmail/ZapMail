<%# This is the refactored 'Edit' page with the consistent TAMU theme and improved layout. %>
<div class="max-w-4xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800">
      Editing: <span class="text-[#500000]"><%= @template.name %></span>
    </h1>

    <%# FIX: The "Back" link is now an icon button in the top-right corner. %>
    <%= link_to templates_path, 
        class: "p-2 rounded-full text-gray-500 hover:bg-gray-200 hover:text-[#500000] transition-colors", 
        title: "Back to Templates" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    <% end %>
  </div>

  <%# This line renders the consistent form partial we've been working on. %>
  <%= render 'form', template: @template %>
</div>
