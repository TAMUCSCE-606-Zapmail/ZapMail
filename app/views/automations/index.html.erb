<div class="container mx-auto">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Automation History</h1>
    <%# This replaces the text button with the consistent "close" icon button %>
    <%= link_to templates_path, 
        class: "p-2 rounded-full text-gray-500 hover:bg-gray-200 hover:text-[#500000] transition-colors", 
        title: "Back to Templates" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    <% end %>
  </div>

  <!-- Status Filter Tabs with TAMU Theme -->
  <div class="mb-6 border-b border-gray-200">
    <nav class="-mb-px flex space-x-8">
      <%# "All" Tab %>
      <%= link_to automations_path, class: "#{params[:status].blank? ? 'border-[#500000] text-[#500000]' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
        All
        <span class="ml-2 bg-gray-200 text-gray-600 py-0.5 px-2.5 rounded-full text-xs font-medium">
          <%= current_user.automations.count %>
        </span>
      <% end %>

      <%# "Scheduled" Tab %>
      <%= link_to automations_path(status: 'scheduled'), class: "#{params[:status] == 'scheduled' ? 'border-[#500000] text-[#500000]' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
        Scheduled
        <span class="ml-2 bg-[#500000]/10 text-[#500000] py-0.5 px-2.5 rounded-full text-xs font-medium">
          <%= current_user.automations.scheduled.count %>
        </span>
      <% end %>
      
      <%# "Completed" Tab %>
      <%= link_to automations_path(status: 'completed'), class: "#{params[:status] == 'completed' ? 'border-[#500000] text-[#500000]' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
        Completed
        <span class="ml-2 bg-green-100 text-green-800 py-0.5 px-2.5 rounded-full text-xs font-medium">
          <%= current_user.automations.completed.count %>
        </span>
      <% end %>

      <%# "Failed" Tab %>
      <%= link_to automations_path(status: 'failed'), class: "#{params[:status] == 'failed' ? 'border-[#500000] text-[#500000]' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
        Failed
        <span class="ml-2 bg-red-100 text-red-800 py-0.5 px-2.5 rounded-full text-xs font-medium">
          <%= current_user.automations.failed.count %>
        </span>
      <% end %>
    </nav>
  </div>

  <!-- Your existing pagination info logic is preserved -->
  <% if @automations.total_count > 0 %>
    <div class="mb-4 text-sm text-gray-600">
      Showing <%= @automations.offset_value + 1 %> - <%= [@automations.offset_value + @automations.size, @automations.total_count].min %> 
      of <%= @automations.total_count %> automations
    </div>
  <% end %>

  <% if @automations.any? %>
    <div class="bg-white shadow-md rounded-lg overflow-hidden border border-gray-200">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Template</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Scheduled For</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Recipient</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Executed At</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @automations.each do |automation| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= automation.template.name %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%# The status badges are now styled with the TAMU theme %>
                <% case automation.status when 'scheduled', 'processing' %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-[#500000]/10 text-[#500000]"><%= automation.status.capitalize %></span>
                <% when 'completed' %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Completed</span>
                <% when 'failed' %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Failed</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= automation.send_at.strftime("%b %d, %Y %I:%M %p") %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= automation.action_data['to'] %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <% if automation.executed? %>
                  <%= automation.executed_at.strftime("%b %d, %Y %I:%M %p") %>
                <% else %>
                  <span class="text-gray-400">—</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= link_to "View Details", automation_path(automation), class: "text-[#500000] hover:underline font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @automations.total_pages > 1 %>
      <div class="mt-6">
        <nav class="flex items-center justify-center space-x-2" aria-label="Pagination">
          <% if @automations.prev_page %>
            <%= link_to ("&larr; Previous").html_safe, automations_path(page: @automations.prev_page, status: params[:status]), class: "px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" %>
          <% else %>
            <span class="px-3 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-300 rounded-md cursor-not-allowed"><%= ("&larr; Previous").html_safe %></span>
          <% end %>

          <span class="px-3 py-2 text-sm font-medium text-gray-700">
            Page <%= @automations.current_page %> of <%= @automations.total_pages %>
          </span>

          <% if @automations.next_page %>
            <%= link_to ("Next &rarr;").html_safe, automations_path(page: @automations.next_page, status: params[:status]), class: "px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" %>
          <% else %>
            <span class="px-3 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-300 rounded-md cursor-not-allowed"><%= ("Next &rarr;").html_safe %></span>
          <% end %>
        </nav>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white shadow-md rounded-lg p-12 text-center border border-gray-200">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">No automations found</h3>
      <p class="mt-1 text-sm text-gray-500">
        <% if params[:status].present? && params[:status] != 'all' %>
          No <%= params[:status] %> automations to display.
        <% else %>
          Get started by scheduling an email campaign from a template.
        <% end %>
      </p>
      <div class="mt-6">
        <%= link_to "View Templates", templates_path, class: "btn-maroon inline-flex items-center px-4 py-2 rounded-md text-sm font-medium" %>
      </div>
    </div>
  <% end %>
</div>
