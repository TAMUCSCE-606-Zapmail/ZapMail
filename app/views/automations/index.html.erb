<div class="container mx-auto px-4 py-8">

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Automation History</h1>
    <%= link_to "Back to Templates", templates_path, class: "bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded" %>
  </div>

  <!-- Status Filter Tabs -->
  <div class="mb-6 border-b border-gray-200">
    <nav class="-mb-px flex space-x-8">
      <%= link_to automations_path, 
          class: "#{params[:status].blank? || params[:status] == 'all' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
        All
        <span class="ml-2 bg-gray-100 text-gray-900 py-0.5 px-2.5 rounded-full text-xs font-medium">
          <%= current_user.automations.count %>
        </span>
      <% end %>

      <%= link_to automations_path(status: 'scheduled'), 
          class: "#{params[:status] == 'scheduled' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
        Scheduled
        <span class="ml-2 bg-blue-100 text-blue-900 py-0.5 px-2.5 rounded-full text-xs font-medium">
          <%= current_user.automations.scheduled.count %>
        </span>
      <% end %>

      <%= link_to automations_path(status: 'completed'), 
          class: "#{params[:status] == 'completed' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
        Completed
        <span class="ml-2 bg-green-100 text-green-900 py-0.5 px-2.5 rounded-full text-xs font-medium">
          <%= current_user.automations.completed.count %>
        </span>
      <% end %>

      <%= link_to automations_path(status: 'failed'), 
          class: "#{params[:status] == 'failed' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
        Failed
        <span class="ml-2 bg-red-100 text-red-900 py-0.5 px-2.5 rounded-full text-xs font-medium">
          <%= current_user.automations.failed.count %>
        </span>
      <% end %>
    </nav>
  </div>

  <!-- Pagination Info -->
  <% if @automations.total_count > 0 %>
    <div class="mb-4 text-sm text-gray-600">
      Showing <%= @automations.offset_value + 1 %> - <%= [@automations.offset_value + @automations.size, @automations.total_count].min %> 
      of <%= @automations.total_count %> automations
    </div>
  <% end %>

  <!-- Automations Table -->
  <% if @automations.any? %>
    <div class="bg-white shadow-md rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Template
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Status
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Scheduled For
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Recipients
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Executed At
            </th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @automations.each do |automation| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">
                  <%= automation.template.name %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% case automation.status %>
                <% when 'scheduled' %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                    Scheduled
                  </span>
                <% when 'completed' %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                    Completed
                  </span>
                <% when 'failed' %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                    Failed
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= automation.send_at.strftime("%b %d, %Y %I:%M %p") %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= automation.action_data['to'] %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <% if automation.executed? %>
                  <%= automation.executed_at.strftime("%b %d, %Y %I:%M %p") %>
                <% else %>
                  <span class="text-gray-400">—</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= link_to "View Details", automation_path(automation), 
                    class: "text-blue-600 hover:text-blue-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination Controls -->
    <% if @automations.total_pages > 1 %>
      <div class="mt-6">
        <nav class="flex items-center justify-center space-x-2" aria-label="Pagination">
          <% if @automations.prev_page %>
            <%= link_to automations_path(page: @automations.prev_page, status: params[:status]), 
                class: "px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
              &larr; Previous
            <% end %>
          <% else %>
            <span class="px-3 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-300 rounded-md cursor-not-allowed">
              &larr; Previous
            </span>
          <% end %>

          <span class="px-3 py-2 text-sm font-medium text-gray-700">
            Page <%= @automations.current_page %> of <%= @automations.total_pages %>
          </span>

          <% if @automations.next_page %>
            <%= link_to automations_path(page: @automations.next_page, status: params[:status]), 
                class: "px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" do %>
              Next &rarr;
            <% end %>
          <% else %>
            <span class="px-3 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-300 rounded-md cursor-not-allowed">
              Next &rarr;
            </span>
          <% end %>
        </nav>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white shadow-md rounded-lg p-12 text-center">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">No automations found</h3>
      <p class="mt-1 text-sm text-gray-500">
        <% if params[:status].present? && params[:status] != 'all' %>
          No <%= params[:status] %> automations to display.
        <% else %>
          Get started by scheduling an email campaign from a template.
        <% end %>
      </p>
      <div class="mt-6">
        <%= link_to "View Templates", templates_path, 
            class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
      </div>
    </div>
  <% end %>
</div>
