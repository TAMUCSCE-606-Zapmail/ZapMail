<div class="max-w-4xl mx-auto">
  <header class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Automation Details</h1>
    <%# FIX: The "Back" link is now a themed icon button with a tooltip %>
    <%= link_to automations_path,
        class: "p-2 rounded-full text-gray-500 hover:bg-gray-200 hover:text-[#500000] transition-colors",
        title: "Back to History" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
    <% end %>
  </header>

  <!-- Template Information Card -->
  <div class="bg-white shadow-md rounded-lg p-6 mb-6 border border-gray-200">
    <h2 class="text-xl font-semibold text-gray-800 mb-4 border-b border-gray-200 pb-2">Template Information</h2>
    <dl class="grid grid-cols-1 md:grid-cols-3 gap-x-4 gap-y-2">
      <dt class="font-medium text-gray-600">Template Name:</dt>
      <dd class="col-span-2">
        <%= link_to @automation.template.name, edit_template_path(@automation.template), class: "link-maroon" %>
      </dd>
      
      <dt class="font-medium text-gray-600">Spreadsheet URL:</dt>
      <dd class="col-span-2">
        <%= link_to @automation.template.spreadsheet_url, @automation.template.spreadsheet_url, target: "_blank", class: "link-maroon break-all" %>
      </dd>
    </dl>
  </div>

  <!-- Execution Details Card -->
  <div class="bg-white shadow-md rounded-lg p-6 mb-6 border border-gray-200">
    <h2 class="text-xl font-semibold text-gray-800 mb-4 border-b border-gray-200 pb-2">Execution Details</h2>
    <dl class="grid grid-cols-1 md:grid-cols-3 gap-x-4 gap-y-2">
      <dt class="font-medium text-gray-600">Status:</dt>
      <dd class="col-span-2">
        <%# FIX: Status badges are now styled with the TAMU theme %>
        <% case @automation.status when 'scheduled', 'processing' %>
          <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-[#500000]/10 text-[#500000]"><%= @automation.status.capitalize %></span>
        <% when 'completed' %>
          <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Completed</span>
        <% when 'failed' %>
          <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Failed</span>
        <% end %>
      </dd>
      
      <dt class="font-medium text-gray-600">Scheduled For:</dt>
      <dd class="col-span-2 text-gray-800">
        <%= @automation.send_at.strftime("%B %d, %Y at %I:%M %p") %>
      </dd>
      
      <dt class="font-medium text-gray-600">Executed At:</dt>
      <dd class="col-span-2 text-gray-800">
        <%= @automation.executed? ? @automation.executed_at.strftime("%B %d, %Y at %I:%M %p") : "Not executed yet" %>
      </dd>
    </dl>
  </div>

  <!-- Action Data Card -->
  <div class="bg-white shadow-md rounded-lg p-6 border border-gray-200">
    <h2 class="text-xl font-semibold text-gray-800 mb-4 border-b border-gray-200 pb-2">Email Content</h2>
    <p class="text-sm text-gray-500 mb-4">This is the exact content that was generated and sent for this job.</p>
    <div class="space-y-3">
        <p><strong class="font-medium text-gray-600">To:</strong> <%= @automation.action_data['to'] %></p>
        <p><strong class="font-medium text-gray-600">Subject:</strong> <%= @automation.action_data['subject'] %></p>
        <div class="border-t border-gray-200 pt-3">
            <strong class="font-medium text-gray-600">Body:</strong>
            <div class="mt-1 prose prose-sm max-w-none"><%= simple_format(@automation.action_data['body']) %></div>
        </div>
    </div>
  </div>

  <!-- Error Message Card (if any) -->
  <% if @automation.error_message.present? %>
    <div class="bg-red-50 border border-red-200 rounded-lg shadow-md p-6 mt-6">
      <h2 class="text-xl font-semibold text-red-800 mb-4 border-b border-red-200 pb-2">Error Message</h2>
      <p class="text-red-700 font-mono text-sm"><%= @automation.error_message %></p>
    </div>
  <% end %>
</div>
