<!DOCTYPE html>
<html>
  <head>
    <title>Zap Mail</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Tailwind CSS is loaded via CDN for simplicity and reliability %>
    <script src="https://cdn.tailwindcss.com"></script>
    
    <%# Google Fonts: Inter %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
      /* --- Refactored TAMU Color Theme --- */
      :root {
        --tamu-maroon: #500000;
        --tamu-white: #FFFFFF;
        --tamu-gray-100: #f7fafc; /* Lightest gray for backgrounds */
        --tamu-gray-200: #edf2f7; /* Light gray for borders, dividers */
        --tamu-gray-700: #4a5568; /* Medium gray for secondary text */
        --tamu-gray-800: #2d3748; /* Dark gray for primary text */
      }
      body {
        font-family: 'Inter', sans-serif;
        background-color: var(--tamu-gray-100);
        color: var(--tamu-gray-800);
      }
      .btn-maroon {
        background-color: var(--tamu-maroon);
        color: var(--tamu-white);
        transition: background-color 0.2s;
      }
      .btn-maroon:hover {
        background-color: #400000;
      }
      .link-maroon {
        color: var(--tamu-maroon);
        font-weight: 500;
        transition: color 0.2s;
      }
      .link-maroon:hover {
        text-decoration: underline;
      }
      .form-input {
        border-color: var(--tamu-gray-200);
      }
      .form-input:focus {
        border-color: var(--tamu-maroon);
        box-shadow: 0 0 0 2px rgba(80, 0, 0, 0.2);
        outline: none;
      }
    </style>
    <%= javascript_importmap_tags %>
  </head>

  <body class="antialiased">
    <header class="bg-white shadow-sm border-b border-gray-200">
      <nav class="container mx-auto px-6 py-4 flex justify-between items-center">
        <div>
          <%# This uses the image_tag from the other branch for a logo %>
          <a href="/">
            <%= image_tag "zapmail-logo.png", alt: "Zapmail Logo", class: "h-10 w-auto object-contain" %>
          </a>
        </div>
        <div class="flex items-center space-x-4">
          <% if logged_in? %>
            <%= link_to 'My Templates', templates_path, class: 'link-primary font-medium' %>
            <%= link_to 'Automation History', automations_path, class: 'link-primary font-medium' %>
            <%= link_to 'My Profile', profile_path, class: 'link-primary font-medium' %>
            <%= button_to 'Logout', logout_path, method: :delete, class: 'bg-red-500 text-white font-semibold py-2 px-4 rounded-lg hover:bg-red-600 transition duration-200' %>
          <% else %>
            <%= link_to 'Login', login_path, class: 'link-maroon' %>
            <%= link_to 'Sign Up', signup_path, class: 'btn-maroon font-semibold py-2 px-4 rounded-lg' %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="container mx-auto px-6 py-8">
      <%# This uses your branch's improved flash message styling %>
      <% flash.each do |type, message| %>
        <% color_class = type == 'success' ? 'bg-green-100 border-green-400 text-green-800' : 'bg-red-100 border-red-400 text-red-800' %>
        <div class="<%= color_class %> border px-4 py-3 rounded-lg relative mb-6" role="alert">
          <span class="block sm:inline"><%= message %></span>
        </div>
      <% end %>
      
      <%= yield %>
    </main>
  </body>
</html>
