<%# app/views/shared/_form_errors.html.erb %>
<% if object.errors.any? %>
  <div id="error_explanation" class="bg-red-50 text-red-700 px-4 py-3 rounded-lg relative border border-red-200 mb-4" role="alert">
    <strong class="font-bold">
      <%= pluralize(object.errors.count, "error") %> prohibited this <%= object.class.name.downcase %> from being saved:
    </strong>
    <ul class="mt-3 list-disc list-inside text-sm">
      <% object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
