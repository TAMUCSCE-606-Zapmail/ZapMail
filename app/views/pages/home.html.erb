<div class="home-header">
    <%= image_tag "zapmail-logo.png", alt: "Zapmail Logo", width: 160, height: 80 %>
</div>

<h1 class="home-title">Zapmail Home</h1>
<div class="home-body">
    <p>Manage your email campaigns with seamless automated workflows at your convenience</p>
    <% if user_signed_in? %>
    <%= link_to "Log Out", destroy_user_session_path, method: :delete %>
    <%= link_to "My Strategies", strategies_path %>
    <% else %>
        <%= link_to "Log In/Sign Up", new_user_session_path %>
    <% end %>
</div>
